{
  "uid": "eventpulse-metrics",
  "title": "EventPulse Metrics",
  "tags": [
    "eventpulse",
    "k3s"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Eventos procesados (rate/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum(rate(events_processed_total[1m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos por fuente",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum(rate(events_processed_total[1m])) by (source)",
          "legendFormat": "{{source}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos enviados al DLQ (rate/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum(rate(events_dlq_total[5m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumidores Kafka activos",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "active_kafka_consumers",
          "legendFormat": "{{source}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia de procesamiento p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(document_processing_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "__auto",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duraci\u00f3n de procesamiento p95 por fuente (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "efx7hse15ik8wd"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(event_processing_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "{{source}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "efx7hse15ik8wd"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}