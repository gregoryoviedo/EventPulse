# Copy to .env for a local run (`python main.py`); docker-compose and Helm
# inject the same variables through the environment instead.

# --- Kafka -------------------------------------------------------------------
# Inside docker-compose: kafka:9092. From the host: localhost:29092.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=raw.events
KAFKA_GROUP_ID=document-processor
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Postgres / pgvector -----------------------------------------------------
# POSTGRES_URI wins; otherwise the URI is built from the POSTGRES_* parts below.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/eventpulse_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=eventpulse_db
EMBEDDINGS_TABLE=document_embeddings

# --- Embeddings --------------------------------------------------------------
# huggingface: real embeddings through the Hugging Face Inference API
# (serverless). openai: real embeddings through an OpenAI-compatible endpoint.
# fake: deterministic vectors, no API key or network, for exercising the
# pipeline locally.
EMBEDDINGS_PROVIDER=huggingface
# Token for api-inference.huggingface.co. Create one at
# https://huggingface.co/settings/tokens (a read token is enough).
HUGGINGFACEHUB_API_TOKEN=hf_tu_token_aqui
# The model served by the Inference API. Its vector width must match
# EMBEDDING_DIMENSIONS exactly (the table is recreated as vector(n) on boot).
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# bge-large-en-v1.5 emits 1024-dimension vectors, so the table must be
# vector(1024). Changing EMBEDDING_DIMENSIONS requires dropping
# document_embeddings: `DROP TABLE document_embeddings;`
EMBEDDING_DIMENSIONS=1024
# For the openai provider instead:
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Comma-separated event types that carry a document in payload.content.
DOCUMENT_EVENT_TYPES=document_uploaded

# --- Generation (RAG completion, POST /api/v1/generate) ----------------------
# huggingface: ChatHuggingFace over a serverless HuggingFaceEndpoint (uses
# HUGGINGFACEHUB_API_TOKEN and LLM_MODEL). openai: ChatOpenAI through an
# OpenAI-compatible endpoint. google: ChatGoogleGenerativeAI (needs GOOGLE_API_KEY
# and the optional langchain-google-genai package). fake: canned answers, no API
# key or network.
LLM_PROVIDER=huggingface
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# For the openai provider instead, set an OpenAI-compatible base URL and key:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://opencode.ai/zen/go/v1
# OPENAI_API_KEY=
# For the google provider:
# GOOGLE_API_KEY=

# --- Service -----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO
