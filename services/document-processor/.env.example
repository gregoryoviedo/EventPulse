# Copy to .env for a local run (`python main.py`); docker-compose and Helm
# inject the same variables through the environment instead.

# --- Kafka -------------------------------------------------------------------
# Inside docker-compose: kafka:9092. From the host: localhost:29092.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=raw.events
KAFKA_GROUP_ID=document-processor
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Postgres / pgvector -----------------------------------------------------
# POSTGRES_URI wins; otherwise the URI is built from the POSTGRES_* parts below.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/eventpulse_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=eventpulse_db
EMBEDDINGS_TABLE=document_embeddings

# --- Embeddings --------------------------------------------------------------
# openai: real embeddings. fake: deterministic vectors, no API key or network,
# for exercising the pipeline locally.
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# Base URL of the OpenAI-compatible endpoint (OpenCode gateway, proxy, ...).
# Leave empty to talk to api.openai.com.
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(n) width of the table; changing it requires recreating it.
EMBEDDING_DIMENSIONS=1536

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Comma-separated event types that carry a document in payload.content.
DOCUMENT_EVENT_TYPES=document_uploaded

# --- Service -----------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO
