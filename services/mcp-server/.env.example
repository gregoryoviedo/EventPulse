# Copy to .env for a local run (`go run .`); docker-compose and Helm inject
# the same variables through the environment instead.

# --- HTTP --------------------------------------------------------------------
# Address for the MCP endpoint (/mcp) and the Kubernetes probes. docker-compose
# maps host 8090.
HTTP_ADDR=:8090

# --- Postgres / pgvector -----------------------------------------------------
# POSTGRES_URI wins; otherwise the URI is built from the POSTGRES_* parts below.
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/eventpulse_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=eventpulse_db
EMBEDDINGS_TABLE=document_embeddings

# --- Embeddings --------------------------------------------------------------
# Must match the provider the document processor used to index the documents,
# because the query vector is compared with the stored ones.
# huggingface: real embeddings through the Hugging Face router (serverless).
# openai: real embeddings through an OpenAI-compatible endpoint.
# fake: deterministic vectors, no API key or network; only exercises the MCP
# wiring, it does NOT rank data indexed with the Python-side fake embedder.
EMBEDDINGS_PROVIDER=huggingface
HUGGINGFACEHUB_API_TOKEN=hf_tu_token_aqui
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Must match the vector(n) width of the table (bge-large-en-v1.5 = 1024).
EMBEDDING_DIMENSIONS=1024
# For the openai provider instead:
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Observability -----------------------------------------------------------
# ENVIRONMENT=development
# OTLP_ENDPOINT=localhost:4317