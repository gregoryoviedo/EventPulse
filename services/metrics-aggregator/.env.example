# Copy to .env for a local run (`go run .`); docker-compose and Helm inject the
# same variables through the environment instead.

# --- Kafka -------------------------------------------------------------------
# Inside docker-compose: kafka:9092. From the host: localhost:29092.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=raw.events
KAFKA_GROUP_ID=metrics-aggregator

# --- HTTP --------------------------------------------------------------------
# Address for GET /metrics and GET /health. docker-compose maps host 9090.
HTTP_ADDR=:9090

# --- Observability -----------------------------------------------------------
# ENVIRONMENT=development
# OTLP_ENDPOINT=